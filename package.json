{
  "name": "windows-tv-ui",
  "productName": "Couch UI",
  "version": "0.1.0",
  "description": "Fullscreen media launcher for a TV, controlled from a phone",
  "author": "Couch UI",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc && node scripts/build-icons.js && vite build",
    "test": "tsc && node --test dist/test/",
    "start": "npm run build && node scripts/run.js",
    "dev": "tsc --watch --preserveWatchOutput",
    "ui:dev": "vite",
    "icon": "node scripts/make-icon.js",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "dist": "npm run build && electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "preact-render-to-string": "^6.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "simple-icons": "^16.38.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "koffi": "^3.3.8",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "build": {
    "appId": "com.couchui.app",
    "productName": "Couch UI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "!dist/test/**",
      "!dist/ui/**",
      "ui-dist/**/*",
      "src/remote/index.html",
      "src/remote/remote.css",
      "config.json",
      "apps.json",
      "build/icon.png",
      "build/simple-icons.json",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Couch-UI-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Couch UI",
      "uninstallDisplayName": "Couch UI",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Couch-UI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Couch-UI-Portable-${version}.${ext}"
    }
  }
}
